LIBUV := file("lib/libuv_a.a") => fun() do
	let Dir := file("libuv"):rmdir:mkdir:chdir
	execute("wget -nv https://dist.libuv.org/dist/v1.51.0/libuv-v1.51.0.tar.gz -O- | tar xzP --strip-components=1")
	execute('CFLAGS=-fpic cmake . -DCMAKE_INSTALL_PREFIX={PATH} -DCMAKE_BUILD_TYPE=Release')
	execute("make -j4")
	execute("make install")
end

:<scope("libuev";) do
	let LIBUEV := file("lib/libuev.a") => fun() do
		let Dir := file("libuev"):rmdir:mkdir:chdir
		execute("git clone --recursive https://github.com/troglobit/libuev.git .")
		execute("./autogen.sh")
		execute('./configure --prefix={PATH}')
		execute("make -j4")
		execute("make install")
	end
	CFLAGS := old + ['-I{file("include")}']
	PREBUILDS := old + [LIBUEV]
	so_module("event/uev.so", [file("uev.o"), LIBUEV])
end>:

LIBEVENT := file("lib/libevent.a") => fun() do
	let Dir := file("libevent"):rmdir:mkdir:chdir
	execute("wget -nv https://github.com/libevent/libevent/releases/download/release-2.2.1-alpha/libevent-2.2.1-alpha-dev.tar.gz -O- | tar xzP --strip-components=1")
	execute('CFLAGS=-fpic cmake . -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_INSTALL_PREFIX={PATH} -DCMAKE_BUILD_TYPE=Release')
	execute("make -j4")
	execute("make install")
end

LIBEVENT_PTHREADS := file("lib/libevent_pthreads.a")[LIBEVENT]
LIBEVENT_OPENSSL := file("lib/libevent_openssl.a")[LIBEVENT]

scope("libevent";) do
	CFLAGS := old + ['-I{file("include")}']
	PREBUILDS := old + [LIBEVENT]
	LDFLAGS := old + ["-lssl"]
	so_module("event/libevent.so", [file("libevent.o")], [LIBEVENT, LIBEVENT_PTHREADS, LIBEVENT_OPENSSL])
	so_module("event/libevent2.so", [file("libevent2.o")], [LIBEVENT, LIBEVENT_PTHREADS, LIBEVENT_OPENSSL])
end

so_module("event.so", [file("event.o")], Tags is ["standard"])