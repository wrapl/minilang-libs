:<let GraphvizUrl := "https://gitlab.com/api/v4/projects/4207231/packages/generic/graphviz-releases/9.0.0/graphviz-9.0.0.tar.gz"

scope("graphviz";) do
	let Dir := file("graphviz")
	let Graphviz := meta("graphviz") => fun() do
		Dir:rmdir:mkdir:chdir
		execute("wget", GraphvizUrl, "-O- | tar xvzP --strip-components=1")
		execute("./configure")
		execute("make clean")
		execute("make -j4")
	end
	PREBUILDS := old + [Graphviz]
	CFLAGS := old + ["-I", Dir/"include"]
	so_module("graph/graphviz.so", [file("graphviz.o")], [])
end>:

so_module("graph/graphviz.so", [file("graphviz.o")], ["-lcdt", "-lcgraph", "-lgvc"], Tags is ["standard"])

scope("adaptagrams";) do
	let Dir := file("adaptagrams")
	let Adaptagrams := meta("adaptagrams") => fun() do
		Dir:rmdir:mkdir:chdir
		execute("git clone --recursive https://github.com/mjwybrow/adaptagrams.git .")
		execute("cd cola && autoreconf -vi")
		execute('cd cola && ./configure --prefix={PATH}')
		execute("cd cola && make clean")
		execute("cd cola && make -j4")
		execute("cd cola && make install")
	end
	PREBUILDS := old + [Adaptagrams]
	CFLAGS := old + ["-I", "include"]
	LDFLAGS := old + ["-L", "lib"]
	so_module("graph/adaptagrams.so", [file("adaptagrams.o")], ["lib/libcola.a", "lib/libvpsc.a"])
end