let GIR := context():parent / "util" :: "GIR"

scope("cairo";) do
	CFLAGS := old + [
		pkgconfig("--cflags cairo-gobject"),
		pkgconfig("--cflags gobject-introspection-1.0")
	]
	LDFLAGS := old + [
		pkgconfig("--libs cairo-gobject"),
		pkgconfig("--libs gobject-introspection-1.0")
	]
	PREBUILDS := old + [GIR]
	so_module("img/cairo.so", [file("cairo.o")], [GIR], Extra is; Library) do
		if PLATFORM = "Darwin" then
			execute("install_name_tool", "-change", GIR, "@loader_path/gir.so", Library)
		else
			execute("patchelf", Library, "--replace-needed", GIR, "\\$ORIGIN/../gir.so")
		end
	end
end
