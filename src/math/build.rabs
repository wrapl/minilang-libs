so_module("math/dist.so", [file("dist.o")])
so_module("math/stat.so", [file("stat.o")])

scope("symengine";) do
	LDFLAGS := old + ["-lsymengine"]
	so_module("math/symengine.so", [file("symengine.o")])
end

scope("msieve";) do
	let Patch := file("msieve.patch")
	let Lib := file("msieve/libmsieve.a")[Patch] => fun() do
		file("msieve"):rmdir:mkdir:chdir
		execute("wget https://github.com/upiter/msieve/archive/refs/tags/v1.54.tar.gz -O- | tar xvzP --strip-components=1")
		execute("patch -p1 <", Patch)
		execute("make -j8 NO_ZLIB=1 all")
	end
	CFLAGS := old + ['-I{file("msieve/include")}']
	PREBUILDS := old + [Lib]
	so_module("math/msieve.so", [file("msieve.o")], [Lib])
end