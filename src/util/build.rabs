so_module("util/bitset.so", [file("bitset.o"), file("roaring.o")])
so_module("util/compare.so", [file("compare.o"), file("diff.o")])

GIR := scope("gir";) do
	CFLAGS := old + [
		"-Wno-switch",
		pkgconfig("--cflags gobject-introspection-1.0")
	]
	LDFLAGS := old + [
		pkgconfig("--libs gobject-introspection-1.0 gio-2.0")
	]

	so_module("gir.so", [file("gir.o")], Tags is ["gtk"])
end

scope("gtk_console";) do
	CFLAGS := old + [
		pkgconfig("--cflags gobject-introspection-1.0"),
		pkgconfig("--cflags gtk4 gdk-pixbuf-2.0 gtksourceview-5")
	]
	let LinkArg := if PLATFORM = "Darwin" then
		"-rpath,@loader_path"
	else
		"-R,'$ORIGIN'"
	end
	LDFLAGS := old + [
		pkgconfig("--libs gobject-introspection-1.0 gio-2.0"),
		pkgconfig("--libs gtk4 gdk-pixbuf-2.0 gtksourceview-5"),
		'-Wl,{LinkArg}'
	]
	PREBUILDS := old + [GIR]
	so_module("gtk_console.so", [file("gtk_console.o"), file("gtk_console_completion.o")], [GIR], Tags is ["gtk"], Extra is; Library) do
		if PLATFORM = "Darwin" then
			execute("install_name_tool", "-change", GIR, "@loader_path/gir.so", Library)
		else
			execute("patchelf", Library, "--replace-needed", GIR, "gir.so")
		end
	end
	share_file("gtksourceview-5/language-specs", "minilang.lang", Tags is ["gtk"])
end

context(""):in(;) meta("gtk_console")[meta("gir"), meta("minilang.lang")]